":"corrupção ativa","refs":[{"ref":{"law":"cp","art":"333","quote":"Oferecer ou prometer vantagem indevida a funcionário público, para determiná-lo a praticar, omitir ou retardar ato de ofício"},"status":"verificado","articleId":"cp.333"}],"docs":[],"status":"verificado"},{"kind":"termo","id":"prevaricacao","title":"prevaricação","refs":[{"ref":{"law":"cp","art":"319","quote":"Retardar ou deixar de praticar, indevidamente, ato de ofício, ou praticá-lo contra disposição expressa de lei, para satisfazer interesse ou sentimento pessoal"},"status":"verificado","articleId":"cp.319"}],"docs":[{"doc":{"obra":"Código Penal Comentado - 26ª Edição 2026","pagina":1073,"trecho":"retardar significa atrasar ou procrastinar"},"status":"verificado"}],"status":"verificado"},{"kind":"termo","id":"condescendencia-criminosa","title":"condescendência criminosa","refs":[{"ref":{"law":"cp","art":"320","quote":"Deixar o funcionário, por indulgência, de responsabilizar subordinado que cometeu infração no exercício do cargo"},"status":"verificado","articleId":"cp.320"}],"docs":[],"status":"verificado"},{"kind":"termo","id":"advocacia-administrativa","title":"advocacia administrativa","refs":[{"ref":{"law":"cp","art":"321","quote":"Patrocinar, direta ou indiretamente, interesse privado perante a administração pública, valendo-se da qualidade de funcionário"},"status":"verificado","articleId":"cp.321"}],"docs":[],"status":"verificado"},{"kind":"termo","id":"desacato","title":"desacato","refs":[{"ref":{"law":"cp","art":"331","quote":"Desacatar funcionário público no exercício da função ou em razão dela"},"status":"verificado","articleId":"cp.331"}],"docs":[],"status":"verificado"},{"kind":"termo","id":"desobediencia","title":"desobediência","refs":[{"ref":{"law":"cp","art":"330","quote":"Desobedecer a ordem legal de funcionário público"},"status":"verificado","articleId":"cp.330"}],"docs":[],"status":"verificado"},{"kind":"termo","id":"falso-testemunho","title":"falso testemunho","refs":[{"ref"